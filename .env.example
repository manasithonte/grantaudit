# Copy to .env and fill in ONE key. .env is git-ignored; never commit real keys.
# Variables already exported in your shell take precedence over this file.

# Google Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Anthropic Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Optional overrides
# GRANTAUDIT_PROVIDER=gemini          # if both keys are set (Claude is the default)
# GRANTAUDIT_MODEL=gemini-3.8-flash   # default: gemini-3.5-flash-lite / claude-haiku-5-5
# GRANTAUDIT_SAT=250000               # default simplified acquisition threshold
